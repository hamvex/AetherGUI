<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:elevation="0dp"
        app:title="@string/app_name"
        app:contentInsetStartWithNavigation="20dp"
        app:contentInsetEndWithActions="12dp"
        app:titleTextColor="@color/text"
        app:menu="@menu/main_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="28dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/hero_gradient">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/status_dot"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:padding="3dp"
                            android:src="@drawable/status_dot"
                            android:contentDescription="@null" />
                        <TextView
                            android:id="@+id/status_phase"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/not_connected_short"
                            android:textAllCaps="true"
                            android:textColor="@color/blue_100"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12" />
                        <TextView
                            android:id="@+id/status_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_version"
                            android:textColor="@color/blue_200"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/status_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/status_disconnected"
                        android:textColor="@color/on_hero"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/status_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/status_ready_message"
                        android:textColor="@color/blue_100"
                        android:textSize="14sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:gravity="top">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="4dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mode_label" android:textColor="@color/blue_100" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/mode_stat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:text="@string/mode_vpn_short" android:textColor="@color/on_hero" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.35" android:orientation="vertical" android:paddingHorizontal="8dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/protocol_label" android:textColor="@color/blue_100" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/protocol_stat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:text="@string/default_protocol_label" android:textColor="@color/on_hero" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="4dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/traffic_label" android:textColor="@color/blue_100" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/traffic_stat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:text="@string/zero_bytes" android:textColor="@color/on_hero" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="18dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/on_hero"
                        app:trackColor="@color/blue_200" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/connect_button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/connect"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_800"
                        app:backgroundTint="@color/on_hero"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_power"
                        app:iconTint="@color/blue_700" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/connection_mode" android:textColor="@color/text" android:textSize="13sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/mode_group"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/vpn_mode_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/vpn_mode" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/smart_mode_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/smart_mode" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/proxy_mode_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/proxy_mode" android:textSize="11sp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <TextView android:id="@+id/mode_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_ready_message" android:textColor="@color/muted" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profile_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_title" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/profile_summary" android:textColor="@color/muted" android:textSize="13sp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/protocol_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/protocol">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/protocol_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/scan_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/scan_mode">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/scan_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/transport_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/transport">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/transport_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/advanced_settings" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/advanced_toggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/show_advanced" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/advanced_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/ip_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="@string/ip_scan"><com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/ip_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/obfuscation_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/obfuscation"><com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/obfuscation_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/log_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/log_level"><com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/log_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/theme_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/theme"><com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/theme_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/language_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/language"><com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/language_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/routing_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/routing"><com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/routing_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/socks_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/socks_address"><com.google.android.material.textfield.TextInputEditText android:id="@+id/socks_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/custom_endpoint" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"><com.google.android.material.textfield.TextInputEditText android:id="@+id/peer_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/mtu" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"><com.google.android.material.textfield.TextInputEditText android:id="@+id/mtu_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/split_apps" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"><com.google.android.material.textfield.TextInputEditText android:id="@+id/split_apps_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:clickable="true" android:inputType="none" android:maxLines="4" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/choose_apps_button" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/choose_apps" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/choose_apps_summary" android:textColor="@color/muted" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/dns_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/dns_protection" android:textColor="@color/text" app:useMaterialThemeColors="true" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dns_protection_summary" android:textColor="@color/muted" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/killswitch_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/kill_switch" android:textColor="@color/text" app:useMaterialThemeColors="true" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/kill_switch_summary" android:textColor="@color/muted" android:textSize="12sp" />
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/reconnect_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/quick_reconnect" android:textColor="@color/text" app:useMaterialThemeColors="true" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quick_reconnect_summary" android:textColor="@color/muted" android:textSize="12sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/reset_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/reset_defaults" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/diagnostics_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/diagnostics" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/test_button" style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/run_test" app:icon="@drawable/ic_diagnostics" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/live_log" android:textColor="@color/muted" android:textSize="12sp" /><com.google.android.material.button.MaterialButton android:id="@+id/clear_logs_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear_logs" android:textSize="11sp" /></LinearLayout>
                    <TextView android:id="@+id/log_text" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="5dp" android:background="@drawable/log_background" android:fontFamily="monospace" android:gravity="top|start" android:padding="12dp" android:scrollbars="vertical" android:text="@string/logs_waiting" android:textColor="@color/log_text" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/telegram_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/blue_100"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="17dp"><ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_telegram" android:contentDescription="@null" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/telegram_title" android:textColor="@color/blue_900" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/telegram_summary" android:textColor="@color/blue_800" android:textSize="12sp" /></LinearLayout><com.google.android.material.button.MaterialButton android:id="@+id/telegram_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/open_channel" android:textSize="11sp" /></LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
