<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/app_picker_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/app_picker_toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/surface" android:title="@string/app_picker_title" android:titleTextColor="@color/text" app:navigationIcon="@drawable/ic_back" />
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="14dp" android:hint="@string/app_picker_search" app:startIconDrawable="@android:drawable/ic_menu_search"><com.google.android.material.textfield.TextInputEditText android:id="@+id/app_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" /></com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="12dp"><com.google.android.material.button.MaterialButton android:id="@+id/select_all_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/select_all" /><com.google.android.material.button.MaterialButton android:id="@+id/clear_all_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/clear_all" /><TextView android:id="@+id/selected_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:gravity="end" android:textColor="@color/muted" android:textSize="12sp" /></LinearLayout>
    <!-- dev.020 CHANGE 8: Show system apps. Default OFF (the normal user-app experience is
         unchanged); ON includes eligible pre-installed system apps in the list below, with the
         same icon/name/package-name rows and the same search. Toggling never touches the
         selected set: previously selected system-app entries are never silently deleted merely
         because they are hidden. -->
    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/show_system_apps_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="12dp" android:text="@string/show_system_apps" android:textColor="@color/text" android:textSize="14sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><ListView android:id="@+id/app_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:divider="@color/border" android:dividerHeight="1dp" android:fastScrollEnabled="true" /><TextView android:id="@+id/app_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/app_picker_empty" android:textColor="@color/muted" android:visibility="gone" /><ProgressBar android:id="@+id/app_loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" /></FrameLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/apply_apps_button" android:layout_width="match_parent" android:layout_height="56dp" android:layout_margin="20dp" android:text="@string/app_picker_done" />
</LinearLayout>
