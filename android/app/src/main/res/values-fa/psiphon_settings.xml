    <string name="psiphon_region_manual_title">کد کشور</string>
    <string name="psiphon_region_manual_help">دو حرف، مثلاً DE، CA، NL یا SE.</string>
    <string name="psiphon_region_manual_valid">در صورت پشتیبانی سایفون، از %1$s خارج می‌شود.</string>
    <string name="psiphon_region_manual_code">دستی: %1$s</string>
    <string name="psiphon_region_auto_compact">🌐 خودکار</string>
    <string name="psiphon_http_title">پروکسی HTTP سایفون</string>
    <string name="psiphon_http_help">پورت پروکسی HTTP ۱۸۱۸ هنگام انتخاب پروتکل سایفونی به‌طور خودکار از طریق سایفون کار می‌کند.</string>
